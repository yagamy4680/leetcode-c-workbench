      "css": ".ds-outline-secondary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.875rem;font-weight:400;line-height:1.5;padding:.25rem .5rem;border:1px solid;border-radius:.25rem;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;background:transparent;color:#6c757d;border-color:#6c757d}.ds-outline-secondary:hover,.ds-outline-secondary:focus-visible,.ds-outline-secondary:active{background:#6c757d;color:#fff}.ds-outline-secondary:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(108,117,125,.5)}.ds-outline-secondary:disabled{pointer-events:none;opacity:.65}@media(prefers-reduced-motion:reduce){.ds-outline-secondary{transition:none}}"
    },
    {
      "name": "Link action",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Compact refresh, reload, log, and history action.",
      "html": "<button type=\"button\" class=\"ds-link\">Reload</button>",
      "css": ".ds-link{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.875rem;font-weight:400;line-height:1.5;padding:.25rem .5rem;border:1px solid;border-radius:.25rem;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;color:#0d6efd;background:transparent;border-color:transparent;text-decoration:underline}.ds-link:hover,.ds-link:active{color:#0a58ca}.ds-link:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(49,132,253,.5)}@media(prefers-reduced-motion:reduce){.ds-link{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Compact field for problem ID or title.",
      "html": "<input type=\"search\" class=\"ds-search\" aria-label=\"Find a problem\" placeholder=\"Find by ID or title\">",
      "css": ".ds-search{width:100%;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.875rem;line-height:1.5;color:var(--ink,#202e3a);background:#fff;padding:.25rem .5rem;border:1px solid #dee2e6;border-radius:.25rem;transition:border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-search:focus{border-color:#86b7fe;outline:0;box-shadow:0 0 0 .25rem rgba(13,110,253,.25)}@media(prefers-reduced-motion:reduce){.ds-search{transition:none}}"
    },
    {
      "name": "Section navigation",
      "kind": "nav",
      "refersTo": "section-navigation",
      "description": "Problem section buttons with current panel state.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Problem sections\"><button type=\"button\" class=\"ds-tab ds-tab-current\" aria-current=\"page\">Solution</button><button type=\"button\" class=\"ds-tab\">Test cases</button><button type=\"button\" class=\"ds-tab\">History</button></nav>",
      "css": ".ds-tabs{display:flex;flex-wrap:wrap;border-bottom:1px solid #dee2e6}.ds-tab{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px;line-height:1.5;color:var(--muted,#536472);background:transparent;padding:.5rem 1rem;border:1px solid transparent;border-radius:.375rem .375rem 0 0;margin-bottom:-1px;cursor:pointer;transition:color .15s ease-in-out,border-color .15s ease-in-out}.ds-tab:hover,.ds-tab:focus{color:#0a58ca;border-color:#e9ecef #e9ecef #dee2e6}.ds-tab:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(13,110,253,.25)}.ds-tab-current{color:#000;font-weight:600;background:#fff;border-color:#dee2e6 #dee2e6 #fff}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}"
    },
    {
      "name": "Problem row",
      "kind": "nav",
      "refersTo": "problem-item",
      "description": "Full-width selected problem with secondary metadata.",
      "html": "<button type=\"button\" class=\"ds-problem\" aria-current=\"page\"><strong>589. N-ary Tree Preorder Traversal</strong><small>Easy \u00b7 2 solutions \u00b7 passed</small></button>",
      "css": ".ds-problem{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:block;width:100%;background:transparent;color:var(--ink,#202e3a);border:0;border-radius:6px;padding:12px 10px;text-align:left;cursor:pointer}.ds-problem strong{display:block;font-size:14px;font-weight:600;line-height:1.5}.ds-problem small{display:block;margin-top:4px;color:var(--muted,#536472);font-size:12.25px;line-height:1.5}.ds-problem:hover{background:#e7ecf1}.ds-problem[aria-current=\"page\"]{background:#dae7f8}.ds-problem:focus-visible{outline:3px solid var(--focus,#1c5cb4);outline-offset:3px;}"
    },
    {
      "name": "Source editor",
      "kind": "custom",
      "refersTo": "code-editor",
      "description": "Dark C editor with a static preview of Prism-rendered syntax beneath the real textarea.",
      "html": "<div class=\"ds-editor\"><pre class=\"ds-gutter\" aria-hidden=\"true\">1\n2\n3</pre><div class=\"ds-source\"><pre class=\"ds-highlight\" aria-hidden=\"true\"><code class=\"ds-highlight-code\"><span class=\"ds-keyword\">int</span> <span class=\"ds-function\">answer</span><span class=\"ds-operator\">(</span><span class=\"ds-keyword\">void</span><span class=\"ds-operator\">) {</span>\n    <span class=\"ds-keyword\">return</span> <span class=\"ds-number\">42</span><span class=\"ds-operator\">;</span>\n<span class=\"ds-operator\">}</span></code></pre><textarea class=\"ds-code\" aria-label=\"Solution source preview\" spellcheck=\"false\" wrap=\"off\" readonly>int answer(void) {\n    return 42;\n}</textarea></div></div>",
      "css": ".ds-editor{display:flex;border:1px solid #35465a;border-radius:6px;overflow:hidden;background:#192633;height:max(380px,calc(100vh - 370px));color-scheme:dark}.ds-source{position:relative;flex:1;min-width:0;height:100%}.ds-gutter,.ds-code,.ds-highlight,.ds-highlight-code{padding:14px 10px;margin:0;font:13px/21px ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:normal;tab-size:4;white-space:pre}.ds-gutter{text-align:right;color:#93a4b5;background:#131e29;min-width:42px;overflow:hidden;user-select:none}.ds-code{position:absolute;inset:0;border:0;outline:none;resize:none;background:transparent;color:transparent;-webkit-text-fill-color:transparent;caret-color:#e1eaf3;width:100%;height:100%;overflow:auto;scrollbar-color:#71859b #131e29}.ds-highlight{position:absolute;inset:0;overflow:hidden;color:#e1eaf3;pointer-events:none}.ds-highlight-code{display:block;padding:0;width:max-content;min-width:100%;color:inherit}.ds-code::selection{background:rgba(76,130,190,.35);color:transparent}.ds-highlight span{font-weight:normal;font-style:normal}.ds-comment{color:#93a4b5}.ds-keyword{color:#c3a6ff}.ds-string,.ds-char{color:#a8d5a2}.ds-number,.ds-boolean{color:#f5c47b}.ds-function{color:#86c6ff}.ds-operator,.ds-punctuation{color:#cfdae5}.ds-macro,.ds-directive,.ds-property{color:#ffaf9f}.ds-editor:focus-within{outline:2px solid var(--focus,#1c5cb4);outline-offset:2px}@media(max-width:1150px){.ds-editor{height:390px}}"
    },
    {
      "name": "Runtime log",
      "kind": "custom",
      "refersTo": "runtime-log",
      "description": "Bounded panel for compiler and runtime output.",
      "html": "<pre class=\"ds-log\" tabindex=\"0\" aria-label=\"Compiler and runtime log\">[passed] example1 \u00b7 8 ms\nprintf output appears here.</pre>",
      "css": ".ds-log{font:12px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;min-height:180px;max-height:340px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;background:#192633;color:#e1eaf3;padding:14px;border-radius:6px;margin:0}.ds-log:focus-visible{outline:3px solid var(--focus,#1c5cb4);outline-offset:3px;}"
    },
    {
      "name": "Dialog surface",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "Native dialog surface for import and fixed submission code.",
      "html": "<section class=\"ds-dialog\" aria-label=\"Submission snapshot\"><h2 class=\"ds-dialog-title\">Submission snapshot</h2><p class=\"ds-dialog-meta\">master \u00b7 code fixed at snapshot time</p><button type=\"button\" class=\"ds-dialog-close\">Close</button></section>",
      "css": ".ds-dialog{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:14px;line-height:1.5;background:#fff;color:var(--ink,#202e3a);border:0;border-radius:12px;padding:26px;max-width:760px;max-height:90vh;overflow:auto;box-shadow:0 16px 50px rgba(16,30,45,.25)}.ds-dialog-title{font-size:23px;font-weight:650;line-height:1.3;letter-spacing:-.02em;margin:0 0 12px}.ds-dialog-meta{color:var(--muted,#536472)}.ds-dialog-close{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.875rem;font-weight:400;line-height:1.5;padding:.25rem .5rem;border:1px solid;border-radius:.25rem;cursor:pointer;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;color:#6c757d;border-color:#6c757d;background:transparent}.ds-dialog-close:hover{background:#6c757d;color:#fff}.ds-dialog-close:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(108,117,125,.5)}@media(prefers-reduced-motion:reduce){.ds-dialog-close{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "A familiar source editor",
    "overview": "The user-approved Bootstrap utility interface uses an editor-and-results workspace with a compact problem navigator. Operate mode applies throughout: clear action labels, visible state, and readable diagnostics guide the interface. This document describes implemented HTML, CSS, and browser JavaScript; it does not claim browser or visual verification.\n\nThe desktop workspace places source and results side by side. Secondary tabs hold test data, the problem description, and history. The surrounding utility UI retains white surfaces, thin dividers, and restrained blue actions. The user-requested dark C editor uses syntax colors, and the diagnostic log remains dark. Native dialogs contain import and submission snapshot tasks.",
    "keyCharacteristics": [
      "Compact Bootstrap controls and platform fonts.",
      "Dark C syntax editor and test results share the main workspace.",
      "Explicit labels accompany run, save, and submission states.",
      "Logs and long data stay in bounded, scrollable regions.",
      "Responsive stacking preserves the same actions on smaller screens."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "State is written in text as well as shown in color; keep result labels, save messages, and memory-check availability visible.",
        "section": "colors"
      },
      {
        "name": "The Aligned Source Rule",
        "body": "Keep the source textarea, syntax layer, and line-number gutter on the same font, padding, and line height; synchronize the highlighted layer with textarea scrolling.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep the source, results, sidebar, and history flat; reserve elevated depth for dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the compact Bootstrap control vocabulary and platform font stacks.",
      "Do keep source, JSON, line numbers, and logs readable in monospace.",
      "Do keep the solution C editor dark with syntax colors while preserving the light utility UI.",
      "Do show written states and recovery instructions alongside color.",
      "Do keep logs, long case details, and tables within scrollable working regions.",
      "Do preserve the implemented responsive stacking and reduced-motion behavior."
    ],
    "donts": [
      "Don't introduce decorative imagery into this utility workspace.",
      "Don't replace explicit action labels with unlabeled icons.",
      "Don't present snapshot code as an editable live solution.",
      "Don't hide unsupported memory checks behind a passing status."
    ]
  }
}
