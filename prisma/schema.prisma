generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Problem {
  id          Int      @id
  title       String
  slug        String
  difficulty  String
  topics      String
  url         String
  updatedAt   DateTime @updatedAt
  solutions   Solution[]
  runs        Run[]
  submissions Submission[]
}

model Solution {
  id          Int      @id @default(autoincrement())
  problemId   Int
  name        String
  sourceHash  String
  problem     Problem  @relation(fields: [problemId], references: [id])
  @@unique([problemId, name])
}

model Run {
  id          String   @id
  problemId   Int
  solution    String
  sourceHash  String
  buildHash   String
  contextHash String   @default("")
  status      String
  passed      Int
  total       Int
  durationMs  Int
  startedAt   DateTime
  problem     Problem  @relation(fields: [problemId], references: [id])
  submissions Submission[]
}

model Submission {
  id          String   @id
  problemId   Int
  solution    String
  sourceHash  String
  commitSha   String
  runId       String?
  result      String   @default("pending")
  memo        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  problem     Problem  @relation(fields: [problemId], references: [id])
  run         Run?     @relation(fields: [runId], references: [id])
}
