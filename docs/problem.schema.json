{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeetCode C Workbench problem bundle",
  "description": "Import-compatible structure. Cross-file references, unique test IDs and UTF-8 byte limits also require the shared validator.",
  "type": "object",
  "required": [
    "manifest",
    "description",
    "files",
    "tests"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "title",
        "slug",
        "difficulty",
        "topics",
        "url"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "slug": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "Easy",
            "Medium",
            "Hard"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "contains": {
            "const": "main.c"
          },
          "items": {
            "type": "string",
            "pattern": "^(?!solution-)[A-Za-z0-9_-]+\\.c$"
          }
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.h$"
          }
        }
      },
      "additionalProperties": true
    },
    "description": {
      "type": "string",
      "description": "Markdown with original HTTPS image references for official diagrams."
    },
    "files": {
      "type": "object",
      "required": [
        "main.c",
        "solution.h",
        "solution-master.c"
      ],
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+\\.(c|h)$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "main.c": {
          "type": "string"
        },
        "solution.h": {
          "type": "string"
        },
        "solution-master.c": {
          "type": "string"
        }
      }
    },
    "tests": {
      "$ref": "#/definitions/tests"
    },
    "overwrite": {
      "type": "boolean",
      "description": "Request-only field; omit from generated artifacts."
    },
    "expectedHash": {
      "type": "string",
      "description": "Request-only confirmation hash from a duplicate response; omit from artifacts."
    }
  },
  "additionalProperties": true,
  "definitions": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "input": {},
          "expected": {},
          "timeoutMs": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60000
          },
          "compare": {
            "enum": [
              "exact",
              "unordered",
              "float"
            ]
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  }
}
